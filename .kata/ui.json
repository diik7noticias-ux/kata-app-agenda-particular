{
  "linting": {
    "enabled": true,
    "rules": {
      "required": [
        "prefer_const_constructors",
        "use_key_in_widget_constructors",
        "avoid_print"
      ],
      "disabled": [
        "avoid_single_cascade_in_expression"
      ]
    },
    "severity": [
      "error",
      "warning"
    ]
  },
  "analysis": {
    "strong_mode": true,
    "strict_casts": true
  }
}